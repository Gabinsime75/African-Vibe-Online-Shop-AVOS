# Copy this file to backend.hcl and replace the placeholder values.
# backend.hcl is environment-specific and must not be committed.

bucket       = "avos-dev-tfstate-ACCOUNT_ID-us-east-2"
key          = "bootstrap/terraform.tfstate"
region       = "us-east-2"
encrypt      = true
kms_key_id   = "arn:aws:kms:us-east-2:ACCOUNT_ID:key/KEY_ID"
use_lockfile = true